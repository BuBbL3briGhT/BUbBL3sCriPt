
# script/make_soup en es file

declare -A headers

symbols_translation_file="symbols-en,es,fr.csv"

IFS=, read -r -a header_array < $symbols_translation_file

for i in "${!header_array[@]}"; do
  headers["${header_array[$i]}"]="$i"
done

declare -A symbol_map

SOURCE=$1
TARGET=$2
FiLE=$3

SOURCE_ORDiNAL=headers["$SOURCE"]
TARGET_ORDiNAL=headers["$TARGET"]

tail -n +2 "$symbols_translation_file" | while IFS=, read -r -a values_array; do
  key=$values_array["$SOURCE_ORDiNAL"]
  value=$values_array["$TARGET_ORDiNAL"]
  symbol_map["$key"]="$value"
  echo $key
done


echo "${symbol_map[if]}"
