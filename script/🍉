#! /usr/bin/env bash

# Symbol Renamer
#
#    $ script/🍉 inicial nuevo [durs]

durs=$(echo $@ | cut -d' ' -f3-)

files=$(git grep -l $1 $durs)

files=$(echo "$files" | \
        sed -E 's/^["'\''"]|["'\''"]$//g')

files=$(printf "%b\n" "$files")

# Just a note that this line is duplicated to handel
# the case where there only a single non-word
# character seperating the same symbol twice.
# -e "s/\(\W\)$1\(\W\)/\1$2\2/g" \
# -e "s/\(\W\)$1\(\W\)/\1$2\2/g" \

echo "$files" | xargs \
  sed -i -e "s/\(\W\)$1\(\W\)/\1$2\2/g" \
         -e "s/\(\W\)$1\(\W\)/\1$2\2/g" \
         -e "s/^$1\(\W\)/$2\1/g" \
         -e "s/\(\W\)$1$/\1$2/g" \
         -e "s/^$1$/$2/g"


