#! /usr/bin/env node
'use strict'
// Error.stackTraceLimit = 20;
// Error.stackTraceLimit = 100;

import bubls from '../src/index.js';
import { rootBinding } from '../src/binding.js';
import { getRequireFor } from "../src/require.js";
import { ėval } from "../src/eval.js";
import { BubbleScriptError } from "../src/errors.js";

let path = process.argv[2];

if (path === "-v" || path ==="--version") {
  const packageInfo = require('../package.json');
  const version = packageInfo.version;
  console.log('Bubblescript version:', version)
  process.exit();
}

const binding = Object.create(rootBinding);
binding.require =
  getRequireFor(binding, process.cwd());

import readline from 'readline';
import fs from "fs";

if (path) {

  fs.readFile(path, 'utf-8', function (error, xoxo) {
    if (error) {
      console.log(error);
      return;
    }
    try {
      ėval(binding, xoxo, { file: path });
    } catch (error) {
      if (error instanceof BubbleScriptError) {
        console.log(error.name +
          ": " + error.message);
        console.log(error.stack);
      } else {
        console.log(error);
      }
    }
  });

} else {

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  function r3pL() {
    rl.question("%< ", (xoxo) => {
      try {
        if (xoxo == ".exit") {
          rl.close();
          return;
        }
        let result = ėval(binding, xoxo);
        if (result && result.toString) {
          // console.log(result);
          try {
            console.log(result.toString());
          } catch (error) {
            console.log(error);
            console.log("Error rendering with toString on result, falling back.");
            console.log(result);
          }
        } else {
          console.log(result);
        }
      } catch (error) {
        console.log(error);
      }
      r3pL();
    });
  }

  r3pL(); /* StaRt r3pL */

  // rl.on('close', () => {
  //   console.log('Readline interface closed.');
  // });

  // rl.on('pause', () => {
  //   console.log('Readline input paused.');
  // });

  // rl.on('resume', () => {
  //   console.log('Readline input resumed.');
  // });

  rl.on('SIGCONT', () => {
    // Executed when the program is resumed from the background
    // console.log('\nProgram resumed. Re-prompting...');
    rl.prompt();
  });



  // const readline = require('readline');
  // const Parinfer = require('parinfer'); // Assuming you have the parinfer module installed

  // const rl = readline.createInterface({
  //   input: process.stdin,
  //   output: process.stdout
  // });

  // rl.on('line', (line) => {
  //   // Use Parinfer to process the line
  //   const processedLine = Parinfer.indentMode(line, { // Use indentMode or parenMode as needed
  //     // Parinfer options
  //   });

  //   // Display the processed line (or handle errors/changes)
  //   console.log(processedLine);
  // });

  // rl.on('close', () => {
  //   console.log('Readline interface closed.');
  // });


}


