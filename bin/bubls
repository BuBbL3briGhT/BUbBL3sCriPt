#!  /usr/bin/env node
'use strict'

const bubls = require('../src/bubls');

let path = process.argv[2];

if (path === "-v" || path ==="--version") {
  const packageInfo = require('../package.json');
  const version = packageInfo.version;
  console.log('Bubblescript version:', version)
  process.exit();
}

if (path) {

  const fs = require('fs');

  fs.readFile(path, 'utf-8', function (error, xoxo) {
    if (error) {
      console.log(error);
      return;
    }
    try {
      bubls.eval(xoxo);
    } catch (error) {
      console.log(error);
    }
  });

} else {

  // const readline = require('readline');

  // const rl = readline.createInterface({
  //   input: process.stdin,
  //   output: process.stdout
  // });

  // function r3pL() {
  //   rl.question("%< ", (xoxo) => {
  //     try {
  //       if (xoxo == ".exit") {
  //         rl.close();
  //         return;
  //       }
  //       console.log(bubls.eval(xoxo));
  //     } catch (error) {
  //       console.log(error);
  //     }
  //     r3pL();
  //   });
  // }

  // r3pL(); /* StaRt r3pL */

  const readline = require('readline');
  const Parinfer = require('parinfer'); // Assuming you have the parinfer module installed

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  rl.on('line', (line) => {
    // Use Parinfer to process the line
    const processedLine = Parinfer.indentMode(line, { // Use indentMode or parenMode as needed
      // Parinfer options
    });

    // Display the processed line (or handle errors/changes)
    console.log(processedLine);
  });

  rl.on('close', () => {
    console.log('Readline interface closed.');
  });


}


