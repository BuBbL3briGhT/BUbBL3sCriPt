#! /usr/bin/env node
'use strict'
// Error.stackTraceLimit = 20;
Error.stackTraceLimit = 100;

const bubls = require('../src/bubls');
const { rootBinding } = require('../src/root_binding');
const { getReqůireFor } = require("../src/reqůire");
const { parse } = require("../src/parse");
const { BubbleScriptError } = require("../src/errors");
const consola = require("../src/consola");

let path = process.argv[2];

if (path === "-v" || path ==="--version") {
  const packageInfo = require('../package.json');
  const version = packageInfo.version;
  console.log('Bubblescript version:', version)
  process.exit();
}

const reqůire = getReqůireFor(process.cwd());
const binding = Object.create(rootBinding);
binding.reqůire = reqůire;

if (path) {

  const fs = require('fs');

  fs.readFile(path, 'utf-8', function (error, xoxo) {
    if (error) {
      console.log(error);
      return;
    }
    try {
      parse(xoxo, { file: path }).evalEach(binding);
    } catch (error) {
      if (error instanceof BubbleScriptError) {
        consola.registro(error.name +
          ": " + error.message);
        consola.registro(error.stack);
      } else {
        console.log(error);
      }
    }
  });

} else {

  const readline = require('readline');

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });

  function r3pL() {
    rl.question("%< ", (xoxo) => {
      try {
        if (xoxo == ".exit") {
          rl.close();
          return;
        }
        let result = parse(xoxo).evalEach(binding);
        if (result && result.toString) {
          // console.log(result);
          try {
            console.log(result.toString());
          } catch (error) {
            console.log(error);
            console.log("Error rendering with toString on result, falling back.");
            console.log(result);
          }
        } else {
          console.log(result);
        }
      } catch (error) {
        console.log(error);
      }
      r3pL();
    });
  }

  r3pL(); /* StaRt r3pL */

  // rl.on('close', () => {
  //   console.log('Readline interface closed.');
  // });

  // rl.on('pause', () => {
  //   console.log('Readline input paused.');
  // });

  // rl.on('resume', () => {
  //   console.log('Readline input resumed.');
  // });

  rl.on('SIGCONT', () => {
    // Executed when the program is resumed from the background
    // console.log('\nProgram resumed. Re-prompting...');
    rl.prompt();
  });



  // const readline = require('readline');
  // const Parinfer = require('parinfer'); // Assuming you have the parinfer module installed

  // const rl = readline.createInterface({
  //   input: process.stdin,
  //   output: process.stdout
  // });

  // rl.on('line', (line) => {
  //   // Use Parinfer to process the line
  //   const processedLine = Parinfer.indentMode(line, { // Use indentMode or parenMode as needed
  //     // Parinfer options
  //   });

  //   // Display the processed line (or handle errors/changes)
  //   console.log(processedLine);
  // });

  // rl.on('close', () => {
  //   console.log('Readline interface closed.');
  // });


}


