#! /usr/bin/env node
'use strict';

const { getRequireFor } =
            require("../src/require");

const [,,relTestPath] = process.argv;

const { parse, rootBinding }
          = require("../src/BubbleScript");

const { mkfn } =
           require("../src/root_binding");

const fs = require('fs');
const path = require('path');

// const testPath =
//   path.resolve(__dirname, relTestPath);

const testPath = path.resolve(relTestPath);

fs.readFile(testPath, 'utf-8', function(error, xoxo) {
  if(error) {
    console.log(error);
    return;
  }
  try {

    const _require =
      getRequireFor(path.dirname(testPath));
    const binding = Object.create(rootBinding);

    // binding.describe =
    //   mkfn(function([title, fn]) {
    //     console.log("  " + title);
    //     // console.log(fn);
    //   });

    // binding.it =
    //   mkfn(function([title, fn]) {
    //     console.log("    " + title);
    //     // console.log(fn);
    //   });

    binding.require =  mkfn(o => _require(...o));


    parse(xoxo).eval(binding);
  } catch (error) {
    console.log(error);
  }
});

