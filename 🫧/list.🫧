(🫧 (map list fn)
  (if (empty? list)
    list
    (push
      (map (pop list) fn)
      (fn (peek list)))))

(🫧 (conj ching chong)
  (send ching "conj" chong))

(🫧 (reduce list fn memo)
  (if (empty? list) memo
    (reduce (pop list) fn
      (fn memo (peek list)))))

