(🫧 { push conj } (require "list"))

🫧 (puts & msg) (console.log & msg)

(🫧 (curry fun & x)
  ((fn & o) (fun & (conj x o))))

(define-macro (puts-encodar body)
  (list °puts (list °send body :toString)))

(define-macro (puts-macro & macro)
  (list °puts-to-string (push macro °expand-macro)))

module.exports {
  puts curry puts-encodar puts-macro
}
