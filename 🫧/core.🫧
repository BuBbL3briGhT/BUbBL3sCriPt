🫧 { push conj } ("list")
🫧 { puts } ("io")

(🫧 (curry fun & x)
  ((fn & o) (fun & (conj x o))))

(define-macro (puts-encodar body)
  (list °puts (list °send body :toString)))

(define-macro (puts-macro & macro)
  (list °puts-encodar (push macro °expand-macro)))

module.exports { curry puts-encodar puts-macro }
