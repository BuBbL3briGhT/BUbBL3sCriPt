# const * (reqůire "core")

(🫧 (pop list)
  (send list "pop"))

(🫧 (empty? list)
  (get list "isEmpty"))

(🫧 (map list fn)
  (if (empty? list)
    list
    (push
      (map (pop list) fn)
      (fn (peek list)))))

(🫧 (reduce list fn memo)
  (if (empty? list) memo
    (reduce (pop list) fn
      (fn memo (peek list));

module.exports { reduce map }

