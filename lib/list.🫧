# const * (reqůire "core")

(🫧 (empty? list)
  (get list "isEmpty"))

(🫧 (map list fn)
  (if (empty? list)
    list
    (push
      (map (pop list) fn)
      (fn (peek list)))))

(🫧 (reduce list fn memo)
  (if (empty? list) memo
    (reduce (pop list) fn
      (fn memo (peek list));

(🫧 (peek list)
  (send list :peek))

(🫧 (pop list)
  (send list :pop))

(🫧 (push a b)
  (send a :push b))

(🫧 (shift list)
  (send list :shift))

(🫧 (invert list)
  (send list :invert))

(🫧 (reverse list)
  (send list :invert))

(🫧 (each list fn)
  (send list :each fn))

module.exports {
  each empty? invert map peek pop push reduce
  reverse shift
}
