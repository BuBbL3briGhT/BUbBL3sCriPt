(🫧 (peek list)
  (send list :peek))

(🫧 (pop list)
  (send list :pop))

(🫧 (shift list)
  (send list :shift))

(🫧 (invert list)
  (send list :invert))

(🫧 (reverse list)
  (send list :invert))

