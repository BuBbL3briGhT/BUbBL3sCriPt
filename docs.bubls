(puts "docs.bubls")
(puts "starting webserver")

(🫧 http (require "http"))
(🫧   fs (require "fs"))
(🫧 path (require "path"))

(🫧 PORT 3000)

(🫧 PUBLiC_DiR
  # Note: __dirname is currently referncing
  # dirname of BubbleScript.js, that should be
  # to refernce the dirname of the currently
  # executing bubblescript file for
  # bubblescript.
  (path.join __dirname "../docs"))

(puts "Public directory:" PUBLiC_DiR)

(🫧 server
  (http.createServer (jsfn [req res]
    (puts "🐈‍⬛️" "Request received.")
    (🫧 requestPath (shift (req.url.split "?")))
    (puts "Requested path:" requestPath)
    (🫧 filePath
      (unless
        (or
          (requestPath.endsWith "/")
          (not (path.extname requestPath)))
        (path.join PUBLiC_DiR requestPath)
        (path.join filePath "index.html")))

    (puts "File path:" filePath)

    (fs.readFile filePath (jsfn [err data]
      (puts "File read.")
      (if err
        (do
          (puts "Error:" err)
          (res.writeHead 404
            (obj "Content-Type" "text/html"))
          (res.end "<h1>404 Not Found</h1>"))
        (do
          (🫧 ext
            (send (path.extname filePath)
                  :substring 1))
          (puts "File extension:" ext)
          (🫧 contentType
            (or (get (obj
                       "html" "text/html"
                        "css" "text/css"
                         "js" "text/javascript"
                        "png" "image/png"
                        "jpg" "image/jpeg"
                        "gif" "image/gif")
                     ext)
                "application/octet-stream"))
          (puts "Content type:" contentType)

          (res.writeHead 200
            (obj "Content-Type" contentType))
          (res.end data))))))))

(server.listen PORT (jsfn []
  (puts "Server running on"
      (+ "http://localhost:" PORT))))
