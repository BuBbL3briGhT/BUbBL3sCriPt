(🫧 http (require "http"))
(🫧   fs (require "fs"))
(🫧 path (require "path"))

(🫧 PORT 3000)

(🫧 PUBLiC_DiR
  (path.join __dirname "docs"))

(🫧 server
  (http.createServer (jsfn [req res]
    (🫧 requestPath (req.url.split "?"))
    (🫧 filePath
      (unless
        (or
          (filePath.endsWith "/")
          (not (path.extname filePath)))
        (path.join PUBLiC_DiR requestPath)
        (path.join filePath "index.html")))

    (fs.readFile filePath (jsfn [err data]
      (if err
        (do
          (res.writeHead 404
            (obj "Content-Type" "text/html"))
          (res.end "<h1>404 Not Found</h1>"))
        (do
          (🫧 ext
            (send (path.extname filePath)
                  :substring 1))
          (🫧 contentType
            (or (get (obj
                       "html" "text/html"
                        "css" "text/css"
                         "js" "text/javascript"
                        "png" "image/png"
                        "jpg" "image/jpeg"
                        "gif" "image/gif")
                     ext)
                "application/octet-stream"))

          (res.writeHead 200
            (obj "Content-Type" contentType))
          (res.end data))))))))

(server.listen PORT (jsfn []
  (puts "Server running on"
      (+ "http://localhost:" PORT))))
