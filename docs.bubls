let http (require 'http')
let fs   (require 'fs')
let path (require 'path')

let PORT 3000

let PUBLiC_DiR \
  (path.join __dirname 'docs')

(let server
  (http.createServer (jsfn [req res]
    (let requestPath (req.url.split "?"))
    (let filePath
      (unless
        (or
          (filePath.endsWith '/')
          (not (path.extname filePath)))
        (path.join PUBLiC_DiR requestPath)
        (path.join filePath 'index.html')))

    (fs.readFile filePath (jsfn [err data]
      (if err
        (do
          (res.writeHead 404 { "Content-Type': 'text/html' })
          (res.end "<h1>404 Not Found</h1>"))
        (do
          (let ext
            (send (path.extname filePath)
                  :substring 1))
          (let contentType
            (or (get {
                    html 'text/html'
                    css  'text/css'
                    js   'text/javascript'
                    png  'image/png'
                    jpg  'image/jpeg'
                    gif  'image/gif'
                  } ext)
                'application/octet-stream'))

          (res.writeHead 200 { "Content-Type" contentType })
          (res.end data)))))

(server.listen PORT (fn []
  (puts `Server running on http://localhost:${PORT}`)))
