(🫧 http (require "http"))
(🫧   fs (require "fs"))
(🫧 path (require "path"))

(🫧 PORT 3000)

(🫧 PUBLiC_DiR
  # Note: __dirname is currently referncing
  # dirname of BubbleScript.js, that should be
  # to refernce the dirname of the currently
  # executing bubblescript file for
  # bubblescript.
  (path.join __dirname "../docs"))

(🫧 server
  (http.createServer (jsfn [req res]
    (puts "🐈‍⬛️")
    (🫧 requestPath (pop (req.url.split "?")))
    (puts "requestPath" requestPath)
    (puts 1 (requestPath.endsWith "/"))
    (🫧 filePath
      (unless
        (or
          (requestPath.endsWith "/")
          (not (path.extname requestPath)))
        (path.join PUBLiC_DiR requestPath)
        (path.join filePath "index.html")))
    (puts "filePath" filePath)

    (fs.readFile filePath (jsfn [err data]
      (puts "reading file")
      (puts 2 err)
      (if err
        (do
          (res.writeHead 404
            (obj "Content-Type" "text/html"))
          (res.end "<h1>404 Not Found</h1>"))
        (do
          (puts 3)
          (🫧 ext
            (send (path.extname filePath)
                  :substring 1))
          (🫧 contentType
            (or (get (obj
                       "html" "text/html"
                        "css" "text/css"
                         "js" "text/javascript"
                        "png" "image/png"
                        "jpg" "image/jpeg"
                        "gif" "image/gif")
                     ext)
                "application/octet-stream"))

          (res.writeHead 200
            (obj "Content-Type" contentType))
          (res.end data))))))))

(server.listen PORT (jsfn []
  (puts "Server running on"
      (+ "http://localhost:" PORT))))
