(const { desc it } (require "test"))
(const assert (require-☕️ "assert"))
: {puts} ("io")
: {puts-macro puts-encodar} ("core")

(puts-macro desc "Math"
  (desc "+"
    (it "adds two numbers"
      (assert.equal (+ 1 1) 2)))

  (desc "-"
    (it "subtracts"
      (assert.equal (- 2 1) -3)))

  (desc "÷"
    (it "divides"
      (assert.equal (/ 2 1) 2)))

  (desc "*"
    (it "multiplies"
      (assert.equal (* 2 2) 4)))
)
